{
  "trailingSlash": false,
  "build": {
    "env": {
      "REACT_APP_HELM_ORIGIN": "https://www.trenston.com",
      "REACT_APP_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudHJlbnN0b24uY29tJA",
      "REACT_APP_CLERK_SIGN_IN_URL": "/login",
      "REACT_APP_CLERK_SIGN_UP_URL": "/sign-up",
      "REACT_APP_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/app",
      "REACT_APP_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/app",
      "REACT_APP_GOOGLE_SITE_VERIFICATION": "",
      "GENERATE_SOURCEMAP": "false"
    }
  },
  "headers": [
    {
      "source": "/og-share.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sign-up",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sign-up/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/payment",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/payment/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "helmcontrol.online"
        }
      ],
      "destination": "https://www.trenston.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.helmcontrol.online"
        }
      ],
      "destination": "https://www.trenston.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!__clerk).*)",
      "has": [
        {
          "type": "host",
          "value": "trenston.com"
        }
      ],
      "destination": "https://www.trenston.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://helm-company-cockpit.onrender.com/api/:path*"
    },
    {
      "source": "/login/:path*",
      "destination": "/login/index.html"
    },
    {
      "source": "/sign-up/:path*",
      "destination": "/sign-up/index.html"
    },
    {
      "source": "/payment/:path*",
      "destination": "/payment/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/((?!api/|__clerk|robots\\.txt|sitemap\\.xml|llms\\.txt|security\\.txt|\\.well-known(?:/.*)?|google[0-9a-z]+\\.html|about(?:/.*)?|features(?:/.*)?|pricing(?:/.*)?|changelog(?:/.*)?|status(?:/.*)?|integrations(?:/.*)?|help(?:/.*)?|security(?:/.*)?|privacy(?:/.*)?|terms(?:/.*)?|refunds(?:/.*)?|login(?:/.*)?|sign-up(?:/.*)?|app(?:/.*)?|payment(?:/.*)?).*)",
      "destination": "/index.html"
    }
  ]
}
