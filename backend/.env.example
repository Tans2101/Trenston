# MongoDB Atlas (required for production — do not use ephemeral/local-only DB)
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=trenston

# Session & security
SESSION_SECRET=change-me-to-a-long-random-string
OAUTH_STATE_SECRET=change-me-oauth-state
COOKIE_SECURE=true
# Use "none" when frontend (Vercel) and API (Render) are different sites without a rewrite proxy.
# Use "lax" when Vercel rewrites /api → Render (same-origin cookies).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=trenston.com

# App URLs (production)
FRONTEND_URL=https://www.trenston.com
APP_URL=https://www.trenston.com
CORS_ORIGINS=https://www.trenston.com,https://trenston.com
# Optional regex for preview hosts (never use ".*" in production)
# CORS_ORIGIN_REGEX=https://.*\.emergentagent\.com

# Feature flags (production)
ALLOW_DEMO_LOGIN=false
DEMO_RESET_ENABLED=false

# AI — direct Anthropic (not Emergent)
# API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model ID — use a current Sonnet string from https://docs.anthropic.com/en/docs/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: cheaper model for report digest summarize/combine (default Haiku)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Clerk (recommended for sign-in — replaces Google OAuth for login)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://clerk.trenston.com/.well-known/jwks.json
# CLERK_PUBLISHABLE_KEY=pk_live_...  # optional — derived from JWKS when unset
CLERK_PRIMARY_ORIGIN=https://www.trenston.com
# Clerk Dashboard → Webhooks → endpoint signing secret (whsec_…)
# Subscribe at least to user.deleted (also session.revoked / session.ended).
# Endpoint URL: https://www.trenston.com/api/webhook/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
SETUP_SECRET=change-me-for-local-setup-endpoint
# Daily retention cron (trial ending + inactivity). Falls back to SETUP_SECRET if unset.
INTERNAL_CRON_SECRET=
# First-party analytics summary (GET /api/internal/analytics-summary). Comma-separated emails.
ANALYTICS_ADMIN_EMAIL=tansherdhawan@gmail.com

# Google OAuth — Calendar, Gmail, Sheets, Drive (Integrations → Connect Google)
# Redirect URI to register: https://www.trenston.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser API key + GCP project number for the Drive file picker (Financials → From Drive)
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Cloud Document AI — invoice parser (uses GCP trial credits, not the user's login)
# Create an Invoice Parser processor, then a service account JSON key.
GCP_PROJECT_ID=
GCP_DOCUMENT_AI_LOCATION=us
GCP_DOCUMENT_AI_PROCESSOR_ID=
GCP_SERVICE_ACCOUNT_JSON=
# Daily Document AI caps (0 disables Document AI; extracts still use Claude)
DOCUMENT_AI_GLOBAL_DAILY_LIMIT=80
DOCUMENT_AI_WORKSPACE_DAILY_LIMIT=8

# QuickBooks OAuth — Accounting sync (Integrations)
# Redirect URI: https://www.trenston.com/api/oauth/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=production

# Xero OAuth — Accounting sync (Integrations); alternative to QuickBooks
# Redirect URI: https://www.trenston.com/api/oauth/xero/callback
# Enable accounting.transactions.read + offline_access on the Xero app.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# HubSpot OAuth — CRM deals sync into Pipeline (Integrations)
# Redirect URI: https://www.trenston.com/api/oauth/hubspot/callback
# Scopes: oauth crm.objects.deals.read crm.objects.companies.read crm.schemas.deals.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Encrypt Google/QuickBooks/Xero/HubSpot/SAP credentials at rest (required in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set the same value on Render → helm-company-cockpit → Environment. Never commit the real key.
# After first deploy with this set, run: python scripts/migrate_encrypt_integration_tokens.py
INTEGRATION_ENCRYPTION_KEY=

# Email (Resend) — optional until team invites
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Paddle Billing — create three prices in Paddle (each with a 7-day trial)
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_GROWTH=
PADDLE_PRICE_ID_BUSINESS=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=production

# When true: Free gets core cockpit; paid features require Starter+
# BILLING_ENFORCED=false

# Note: legacy PADDLE_PRICE_ID / PRO_PRICE are no longer used for checkout.
# Tier amounts: Free $0 / Starter $15 / Growth $39 / Business $99 (backend/plans.py).
# Existing plan=pro workspaces migrate to starter — see DEPLOY.md.

# Cloudflare R2 — private document storage for bill/receipt uploads
# Prefer R2_ACCOUNT_ID; endpoint is derived as https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Or set R2_ENDPOINT explicitly. Full walkthrough: docs/R2_SETUP.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Document upload/extract rate limits (per workspace, rolling 1-hour window via Mongo TTL)
DOC_UPLOAD_HOURLY_LIMIT=30
# DOC_EXTRACT_HOURLY_LIMIT=30

# Abandoned uploads (never committed to a financial entry) — cleaned by /api/admin/cleanup-orphaned-documents
DOC_ORPHAN_RETENTION_DAYS=7

# --- Integrations quick reference (see /INTEGRATIONS.md) ---
# Google Calendar OAuth → Calendar + briefing context
# QuickBooks OAuth → Financials sync (/api/integrations/quickbooks/sync)
# Xero OAuth → Financials sync (/api/integrations/xero/sync)
# HubSpot OAuth → Pipeline deals sync (/api/integrations/hubspot/sync)
# ANTHROPIC_API_KEY → briefing, Ask Trenston, bill extraction
# R2_* → document upload on Financials
# RESEND_API_KEY → team invite emails
# PADDLE_* → billing when BILLING_ENFORCED=true
